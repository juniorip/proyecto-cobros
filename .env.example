# BCP account-to-DNI verification (server only; never use NEXT_PUBLIC_ prefixes)
BCP_API_ENV=certification
BCP_API_CLIENT_ID=
BCP_API_CLIENT_SECRET=
BCP_API_SUBSCRIPTION_KEY=
# Provide either the PFX pair, or PEM certificate and private key:
BCP_API_CLIENT_PFX_BASE64=
BCP_API_CLIENT_PFX_PASSPHRASE=
# BCP_API_CLIENT_CERT=
# BCP_API_CLIENT_KEY=
# BCP_API_CLIENT_KEY_PASSPHRASE=
# Optional; defaults to checking the account product families listed in BCP's API spec.
# BCP_API_ACCOUNT_SUBTYPE=CurrentAccount
